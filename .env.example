# OpenAI-совместимый endpoint. По умолчанию Groq: сайт и API открываются из РФ.
# Ключ: https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Низкая температура: карточка переносит факты, а не сочиняет текст.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4000
AI_TIMEOUT=90
# Повторы только при сетевом сбое и 429/5xx. Проверка фактов повтором не лечится.
AI_RETRIES=2
